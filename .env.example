# Environment variables
# Copy to .env for local configuration. The current app loads environment variables
# from the process environment; compose.yaml does not automatically load this file.

# PostgreSQL connection. The default matches compose.yaml's local development DB.
DATABASE_URL=postgresql+psycopg://lenny_user:local_dev_password@127.0.0.1:5433/lenny_assistant

# Local Ollama server (required for chat and the Pi essay skill).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional cloud chat/agent provider. Set both values to switch; no fallback is automatic.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Pi-specific local model override; defaults to OLLAMA_MODEL.
PI_OLLAMA_MODEL=qwen2.5:3b

# Optional transcript source directory and indexing/retrieval settings.
RAG_SOURCE_DIR=data/sources
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_FTS_MIN_RANK=0.01

# Optional executable name/path for Node.js used by the Pi bridge.
PI_NODE_EXECUTABLE=node
